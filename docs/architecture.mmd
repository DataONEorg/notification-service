flowchart LR
    subgraph "Sources Pod"
        subgraph "Event Sources"
            A(["'DatasetChanges'<br/>(Solr) event source"])
            B(["'View' & 'Download'<br/>(Metrics) event source"])
            H(["Future event source"])
        end
        C["<b>Subscription<br/>Processor</b><br/><em>(who's subscribed<br/>to this event?<br/>Update DB to
        newPid)</em>"]
    end
    D["<b>Notifications<br/>Queue</b><br/><em>(1 notification<br/>per event,<br/>per recipient</em>)
    "]@{ shape: trapezoid-bottom }
    subgraph "Outputs Pod"
        E["<b>Notifications<br/>Consumer</b><br/><em>(throttling;<br/>grouping?)</em>"]
        subgraph Channels
            F(["<b>Email service</b><br/>chooses template based on<br/>SubscriptionResourceType"])
            G(["(Future channels;<br/>eg SMS)"])
        end
    end
    I["Database<br/>(Postgres)"]@{ shape: cylinder }
    J["<b>Account<br/>Service</b><br/><em>(get email,<br/>SMS etc for<br/>subscriberId)</em>"]

    A -- <em> { subscribedPid:123<br/>newPid:456<br/>SubscriptionResourceType:
datasetChanges }</em> --> C
    B --> C
    C -- <em> { subscriberId:0000-0002-1472-913X<br/>newPid:456<br/>SubscriptionResourceType:
datasetChanges }</em> --> D
    D --> E
    E --> F
    J --> E
    E --> G
    H --> C
    C <-- <em>lastSuccessfulRuntime</em> --> I
    I -- <em>lastSuccessfulRuntime</em> --> A
    I -- <em>Metadata for msg template (Title etc)</em> --> E

