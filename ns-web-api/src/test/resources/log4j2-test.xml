<?xml version="1.0" encoding="UTF-8"?>
<!-- monitorInterval, in seconds, is time between log4j reloading config changes automatically -->
<Configuration status="warn" monitorInterval="30">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="notification-service %d{yyyyMMdd-HH:mm:ss}: [%p]: %m [%C:%M:%L]%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!--
        Root log level defaults to DEBUG. Override from the command line if needed, using
        '-DLOG_LEVEL='; e.g.:
                        mvn verify -DLOG_LEVEL=warn
        -->
        <Root level="${sys:LOG_LEVEL:-debug}">
            <AppenderRef ref="Console"/>
        </Root>

        <Logger name="org.jboss" level="error" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="com.github.dockerjava" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="com.github.dockerjava.zerodep" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.testcontainers.utility.RyukResourceReaper" level="error"
                additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="com.zaxxer.hikari.pool" level="error" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!--
        ↓ these control http logging output from Rest Assured. Defaults to ERROR. Override from
                      the command line if needed, using '-DLOG_LEVEL='; e.g.:

        mvn verify -DLOG_LEVEL=debug mvn -PsmokeTest \
        -DBASE_URL="$BASE_URL" -DTOKEN="$TOKEN"
        -->
        <Logger name="io.restassured" level="${sys:LOG_LEVEL:-warn}" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.apache.http" level="${sys:LOG_LEVEL:-warn}" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.apache.http.wire" level="${sys:LOG_LEVEL:-warn}" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>
