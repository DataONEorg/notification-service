    <profiles>
        <profile>
            <id>smokeTest</id>
            <build>
                <plugins>
                    <!-- Skip unit tests (Surefire) only in this profile -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire.version}</version>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <!-- run only *SmokeIT integration tests in this profile -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${failsafe.version}</version>
                        <executions>
                            <execution>
                                <id>it</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>smoke-it</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>integration-test</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/*SmokeIT.java</include>
                                    </includes>
                                    <systemPropertyVariables>
                                        <!--suppress UnresolvedMavenProperty -->
                                        <BASE_URL>${env.BASE_URL}</BASE_URL>
                                        <!--suppress UnresolvedMavenProperty -->
                                        <TOKEN>${env.TOKEN}</TOKEN>
                                    </systemPropertyVariables>
                                    <useModulePath>false</useModulePath>
                                </configuration>
                            </execution>
                            <execution>
                                <id>verify</id>
                                <phase>verify</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <it.tags>smokeTest</it.tags>
            </properties>
        </profile>
    </profiles>
