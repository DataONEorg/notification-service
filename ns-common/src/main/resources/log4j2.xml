<?xml version="1.0" encoding="UTF-8"?>
<!-- monitorInterval, in seconds, is time between log4j reloading config changes automatically -->
<Configuration status="warn" monitorInterval="30">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="notification-service %d{yyyyMMdd-HH:mm:ss}: [%p]: %m [%C:%M:%L]%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!--
        Root log level defaults to ERROR. Override from the command line if needed, using
        '-DLOG_LEVEL='; e.g.:
                        mvn verify -DLOG_LEVEL=debug
        -->
        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>
        <Logger name="org.jboss" level="error" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
    </Loggers>
</Configuration>
